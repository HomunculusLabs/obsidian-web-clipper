{
  "$schema": "../schemas/github-regression-contract.schema.json",
  "contract_version": "1.0.0",
  "repo": {
    "owner": "charmbracelet",
    "repo": "vhs",
    "url": "https://github.com/charmbracelet/vhs"
  },
  "package_name": {
    "value": "vhs",
    "source": "package.json",
    "fallback_used": false
  },
  "expected_filename": "vhs",
  "readme_extraction": {
    "mode": "root_readme",
    "url_variants": [
      {
        "url": "https://github.com/charmbracelet/vhs",
        "type": "root_repo",
        "expected_success": true
      },
      {
        "url": "https://github.com/charmbracelet/vhs/tree/main",
        "type": "tree_path",
        "expected_success": true
      }
    ],
    "content_selector": "article.markdown-body",
    "remove_selectors": [
      ".markdown-body .octicon-pencil",
      ".markdown-body a[aria-label*='Edit']",
      "button[data-clipboard-target]",
      ".zeroclipboard-button",
      ".markdown-body a.anchor",
      ".Layout-sidebar nav[aria-label='Page navigation']",
      ".file-navigation",
      ".js-socket-channel"
    ]
  },
  "expected_frontmatter": {
    "source": "https://github.com/charmbracelet/vhs",
    "title": "charmbracelet/vhs",
    "filename": "vhs",
    "type": "github-repo",
    "site": "github",
    "extra": {
      "github_owner": "charmbracelet",
      "github_repo": "vhs",
      "github_package_name": "vhs",
      "github_stars": {
        "extract": true,
        "assert": "> 0"
      },
      "github_forks": {
        "extract": true,
        "assert": "> 0"
      },
      "github_language": {
        "extract": true,
        "expected": "Go"
      }
    }
  },
  "expected_markdown_structure": {
    "title_pattern": "# VHS",
    "repo_context_pattern": "> Repository: \\[charmbracelet/vhs\\]\\(https://github.com/charmbracelet/vhs\\).*",
    "required_sections": [
      "## Installation",
      "## Usage",
      "## Related Projects",
      "## Contributing",
      "## License"
    ],
    "code_blocks": [
      {
        "language": "sh",
        "content_pattern": "go install github.com/charmbracelet/vhs@latest"
      },
      {
        "language": "text",
        "content_pattern": "Output demo.gif"
      }
    ]
  },
  "metadata_extraction": {
    "stars": {
      "selector": "[data-ga-click*='star button']",
      "expected_min": 20000
    },
    "forks": {
      "selector": "[data-ga-click*='fork button']",
      "expected_min": 400
    },
    "language": {
      "selector": "[itemprop='programmingLanguage']",
      "expected": "Go"
    },
    "topics": [
      "terminal",
      "gif",
      "recorder"
    ]
  },
  "discovery_config": {
    "depth_limit": 1,
    "dedupe_strategy": "url_deduplication",
    "ordering": "alphabetical_by_url",
    "include_patterns": [
      "https://github.com/[^/]+/[^/]+$"
    ],
    "exclude_patterns": [
      "^https://github\\.com/charmbracelet/vhs$",
      "^https://github\\.com/[^/]+/[^/]+/(issues|pull|tree|blob|wiki|actions|releases)/",
      "^https://github\\.com/[^/]+/[^/]+/tree/[^/]+/"
    ]
  }
}
